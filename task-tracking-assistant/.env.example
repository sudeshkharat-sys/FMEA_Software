# Pick ONE provider. The app auto-detects from whichever key is set
# (or force it with LLM_PROVIDER=azure|openai|groq).

# --- Option A: OpenAI / GPT-4o-mini (also works with a company OpenAI-compatible gateway) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Option B: Azure OpenAI ---
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<your gpt-4o-mini deployment name>
# AZURE_OPENAI_API_VERSION=2024-06-01

# --- Option C: Groq (free; may be blocked on company networks) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Only if you get CERTIFICATE_VERIFY_FAILED: path to your company root certificate (Base64 .pem/.cer)
# CA_BUNDLE=C:\certs\company-root.pem
